# Server & Security
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super-secret-random-key-at-least-32-chars-long
WORKFLOW_API_SECRET=super-secret-workflow-jwt-signing-key-32-chars
ALLOWED_ADMIN_EMAIL=your-email@gmail.com

# Database (Postgres connection string)
DATABASE_URL=postgres://autopilot:autopilotpass@localhost:5432/creator_autopilot

# Object Storage (S3 / Backblaze B2 / R2)
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_REGION=us-east-005
STORAGE_BUCKET=creator-autopilot-assets
STORAGE_ACCESS_KEY_ID=your-b2-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-b2-secret-access-key

# AI Provider
GEMINI_API_KEY=your-gemini-api-key

# Notification (Ntfy)
NTFY_TOPIC=creator-autopilot-alerts-secret-suffix
NTFY_SERVER_URL=https://ntfy.sh

# Platform Tokens (Stored encrypted in DB, defaults for testing)
ENCRYPTION_KEY=32-byte-hex-encoded-aes-key-for-database-token-encryption

# YouTube Data API v3 OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# External Free Tools
PEXELS_API_KEY=your-pexels-api-key-optional
